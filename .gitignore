# D:\pikayu 下还有 5KPlayer、TCHESS、Pikafish 等第三方软件和压缩包，一律不进仓库。
# 采用白名单：只收以下目录和根目录说明文件。
/*
!/server/
!/ios/
!/.github/
!/docs/
!/README.md
!/LICENSE
!/.gitignore

# server 内的本地产物
server/.venv/
server/__pycache__/
server/debug/
server/requests.log
server/server.out.log
server/server.err.log
server/diag.txt
server/diag.bat
server/diag_run.py
server/fix.bat

# ios 本地/CI 产物
ios/*.xcodeproj/
ios/build/
ios/Payload/
ios/*.ipa
ios/build.log
